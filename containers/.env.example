# Copy to containers/.env (untracked) and replace every <placeholder>. Never commit .env.
# Generate each secret with: openssl rand -hex 24
# or (PowerShell):  -join ((1..24) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# Use only URL-safe characters (letters, digits, - _ . ~); POSTGRES_PASSWORD is embedded in a URL.

# --- Required (compose refuses to start without these) ---
POSTGRES_PASSWORD=<generate-a-long-random-value>
S3_ACCESS_KEY=<generate-a-random-access-key-min-3-chars>
S3_SECRET_KEY=<generate-a-long-random-secret-min-8-chars>

# --- Optional ---
# Published app port (plain HTTP). In production the LAN reverse proxy (Caddy) forwards to it;
# never forward this port on the router.
# APP_PORT=6610
# Exact browser origin, no trailing slash. It must match the address typed in the browser
# (127.0.0.1 and localhost are different origins).
# APP_ORIGIN=http://127.0.0.1:6610
# Set APP_ORIGIN=https://mindmap.adena.dev and API_NODE_ENV=production for public access
# (deploy.sh does this when absent).
# API_NODE_ENV=development
# Private attachment bucket name.
# S3_BUCKET=friendly-mindmap
# Username for bootstrap-admin / rotate-password (default for bootstrap: adena).
# ACCOUNT_USERNAME=adena
